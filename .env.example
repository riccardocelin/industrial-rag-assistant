########### Compose level ##########
API_IMAGE_NAME=rag-api
API_IMAGE_TAG=latest
UI_IMAGE_NAME=ui-api
UI_IMAGE_TAG=latest

########### App level ##############
# App
APP_NAME=Industrial RAG API
API_HOST=localhost
API_PORT=8000
API_ASK_ENDPOINT=/ask
UI_PORT=8501

# OpenAI
OPENAI_API_KEY=<your_openai_api_key_here>
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION_NAME=technical_docs

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3